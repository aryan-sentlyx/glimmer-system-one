# Copy this file to .env and fill in the values. Never commit .env.
MODEL_API_KEY=LLM|000000|secret        # Muse API key from dev.meta.ai
HF_TOKEN=hf_xxx                        # Hugging Face token, read access
HF_WRITE_TOKEN=hf_xxx                  # Hugging Face write token of aryan-sentlyx, used only by release/upload.py
OPENROUTER_API_KEY=sk-or-xxx                # OpenRouter key, used for Jev 1.14 and other decision models
ELEVENLABS_API_KEY=sk_xxx                   # ElevenLabs key, used only by video/voice/generate_voice.py
ELEVENLABS_VOICE_ID=                        # optional, the id of the voice clone; `clone` also writes video/voice/voice.json
